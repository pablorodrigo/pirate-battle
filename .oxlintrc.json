{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["src/game/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react-dom/*", "axios", "msw", "msw/*", "@tanstack/*"],
                "message": "The game layer must not depend on React or on the data layer."
              },
              {
                "group": ["**/app/**", "**/features/**", "**/mocks/**", "**/shared/api/**"],
                "message": "The game layer must not depend on application or data modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/game/core/**", "src/game/config/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["pixi.js", "pixi.js/*", "react", "react-dom", "react-dom/*", "axios", "msw", "msw/*", "@tanstack/*"],
                "message": "Game rules must stay independent of rendering, React and the network."
              },
              {
                "group": ["**/app/**", "**/features/**", "**/mocks/**", "**/shared/**", "**/rendering/**", "**/runtime/**", "**/input/**", "**/assets/**"],
                "message": "Game rules may only import from game/core and game/config."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/contracts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react-dom/*", "pixi.js", "pixi.js/*", "axios", "msw", "msw/*", "@tanstack/*"],
                "message": "Contracts are plain types and validators shared by the client and the mocks."
              },
              {
                "group": ["**/app/**", "**/features/**", "**/mocks/**", "**/shared/api/**", "**/rendering/**", "**/runtime/**", "**/input/**"],
                "message": "Contracts may only depend on other contracts and on game configuration."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react-dom/*", "pixi.js", "pixi.js/*", "msw", "msw/*", "@tanstack/*"],
                "message": "The HTTP layer must not depend on React, rendering or the mock implementation."
              },
              {
                "group": ["**/app/**", "**/features/**", "**/mocks/**", "**/game/**"],
                "message": "The HTTP layer must not depend on application, game or mock modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/mocks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "react-dom/*", "pixi.js", "pixi.js/*", "axios", "@tanstack/*"],
                "message": "Mocks emulate the server and must not depend on client libraries."
              },
              {
                "group": ["**/app/**", "**/features/**"],
                "message": "Mocks must not depend on application modules."
              }
            ]
          }
        ]
      }
    }
  ]
}
