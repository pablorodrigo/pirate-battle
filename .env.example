# Every variable is public: Vite inlines VITE_* values into the client bundle.

# Serve the API from the MSW mocks (default: true). The published demo relies on them.
VITE_ENABLE_MOCKS=true

# Base URL of the API (default: /api).
VITE_API_BASE_URL=/api

# Milliseconds before an API request is abandoned (default: 8000).
VITE_API_TIMEOUT_MS=8000
